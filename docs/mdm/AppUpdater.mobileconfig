<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PayloadDisplayName</key>
    <string>App Updater Settings</string>
    <key>PayloadDescription</key>
    <string>Enforces App Updater update policies for this organization.</string>
    <key>PayloadIdentifier</key>
    <string>com.example.mdm.macappupdater</string>
    <key>PayloadOrganization</key>
    <string>Example Corp</string>
    <key>PayloadScope</key>
    <string>System</string>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadUUID</key>
    <string>5B0D9C2E-6A41-4C1F-9E58-2F3A7D1B8C40</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
    <key>PayloadRemovalDisallowed</key>
    <false/>
    <key>PayloadContent</key>
    <array>
        <dict>
            <key>PayloadType</key>
            <string>com.apple.ManagedClient.preferences</string>
            <key>PayloadIdentifier</key>
            <string>com.example.mdm.macappupdater.prefs</string>
            <key>PayloadUUID</key>
            <string>A7E3F1D2-3C4B-4E5A-8F69-0B1C2D3E4F50</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadDisplayName</key>
            <string>App Updater Managed Preferences</string>
            <key>PayloadContent</key>
            <dict>
                <key>com.macappupdater.app</key>
                <dict>
                    <key>Forced</key>
                    <array>
                        <dict>
                            <key>mcx_preference_settings</key>
                            <dict>
                                <key>CheckIntervalHours</key>
                                <integer>6</integer>
                                <key>AutoInstallEnabled</key>
                                <true/>
                                <key>DefaultPolicy</key>
                                <string>autoInstall</string>
                                <key>PerAppPolicies</key>
                                <dict>
                                    <key>com.microsoft.VSCode</key>
                                    <string>notifyOnly</string>
                                </dict>
                                <key>IgnoredBundleIdentifiers</key>
                                <array>
                                    <string>com.adobe.Photoshop</string>
                                </array>
                                <key>DeferralDays</key>
                                <integer>3</integer>
                                <key>RequireACPower</key>
                                <true/>
                                <key>AvoidExpensiveNetwork</key>
                                <true/>
                                <key>DisableUninstaller</key>
                                <true/>
                                <key>DisableBetaChannels</key>
                                <true/>
                                <key>AllowedSources</key>
                                <array>
                                    <string>sparkle</string>
                                    <string>homebrew</string>
                                    <string>appStore</string>
                                    <string>github</string>
                                </array>
                                <key>HideMenuBarIcon</key>
                                <false/>
                                <key>RequireNotarization</key>
                                <true/>
                            </dict>
                        </dict>
                    </array>
                </dict>
            </dict>
        </dict>
    </array>
</dict>
</plist>
