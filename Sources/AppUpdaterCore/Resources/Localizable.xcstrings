        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanal Alan Kapsayıcısı"
          }
        }
      }
    },
    "Saved Window State": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı Pencere Durumu"
          }
        }
      }
    },
    "Signed by team %@, but was previously signed by %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signed by team %1$@, but was previously signed by %2$@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ekibi tarafından imzalanmış, ancak daha önce %2$@ tarafından imzalanmıştı."
          }
        }
      }
    },
    "Team identifier mismatch (expected %@, got %@)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Team identifier mismatch (expected %1$@, got %2$@)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekip tanımlayıcısı uyuşmuyor (beklenen %1$@, gelen %2$@)"
          }
        }
      }
    },
    "The app has no developer signature, so its origin cannot be verified.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamanın geliştirici imzası yok, bu nedenle kaynağı doğrulanamıyor."
          }
        }
      }
    },
    "The bundle may be damaged or modified. Reinstall it from the developer's site.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paket hasarlı veya değiştirilmiş olabilir. Geliştiricinin sitesinden yeniden yükleyin."
          }
        }
      }
    },
    "The code signature failed validation: %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod imzası doğrulanamadı: %@"
          }
        }
      }
    },
    "The new version will not launch on the macOS version you are running.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
