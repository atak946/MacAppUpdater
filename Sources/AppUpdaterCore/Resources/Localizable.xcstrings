      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayrıcalıklı yardımcı etkin değil (%@)"
          }
        }
      }
    },
    "Quiet hours": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessiz saatler"
          }
        }
      }
    },
    "Release notes are not valid UTF-8 text": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürüm notları geçerli UTF-8 metni değil"
          }
        }
      }
    },
    "Release notes are too large (%lld bytes, limit %lld)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Release notes are too large (%1$lld bytes, limit %2$lld)"
          }
        },
