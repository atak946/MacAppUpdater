      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yükleyici paketleri onayınızı gerektirir"
          }
        }
      }
    },
    "Intel-only app": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca Intel uygulaması"
          }
        }
      }
