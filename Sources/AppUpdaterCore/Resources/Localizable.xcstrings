        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tercihler (ByHost)"
          }
        }
      }
    },
    "Privileged helper did not respond in time": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayrıcalıklı yardımcı zamanında yanıt vermedi"
          }
        }
      }
    },
    "Privileged helper error: %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayrıcalıklı yardımcı hatası: %@"
          }
        }
      }
    },
