          "stringUnit": {
            "state": "translated",
            "value": "İmzasız"
          }
        }
      }
    },
    "Nothing is selected.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir şey seçilmedi."
          }
        }
      }
    },
    "On an expensive network": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pahalı bir ağa bağlı"
          }
        }
      }
    },
    "Only keep it if you trust where it came from; prefer an official signed download.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca kaynağına güveniyorsanız tutun; resmi ve imzalı bir indirmeyi tercih edin."
          }
        }
      }
    },
    "Open %@ to update this app.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulamayı güncellemek için %@ uygulamasını açın."
