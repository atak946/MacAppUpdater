      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçersiz paket tanımlayıcısı: %@"
          }
        }
      }
    },
    "Invalid formula name: %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçersiz formül adı: %@"
