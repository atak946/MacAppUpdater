    "Launch Agent": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlatma Aracısı"
          }
        }
      }
    },
    "Logs": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlükler"
          }
        }
      }
    },
    "Low Data Mode is on": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düşük Veri Modu açık"
          }
        }
      }
    },
    "Managed by %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tarafından yönetiliyor"
          }
        }
      }
    },
    "Needs Rosetta 2; Apple is phasing out Rosetta.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosetta 2 gerektirir; Apple, Rosetta desteğini aşamalı olarak sonlandırıyor."
          }
        }
      }
    },
    "Network error: %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağ hatası: %@"
          }
        }
      }
    },
    "Network status unknown": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağ durumu bilinmiyor"
          }
        }
      }
    },
    "Not compatible with this Mac": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac ile uyumlu değil"
          }
        }
      }
    },
    "Not notarized": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Noter onaylı değil"
          }
        }
