    "HTTP Storage": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP Depolama"
          }
        }
      }
    },
    "Homebrew is not installed": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew yüklü değil"
          }
        }
