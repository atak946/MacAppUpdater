{
  "sourceLanguage": "en",
  "strings": {
    "\"%@\" is not a valid owner/repo.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" geçerli bir sahip/depo değil."
          }
        }
      }
    },
    "%@ and %lld more": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ and %2$lld more"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ve %2$lld tane daha"
          }
        }
      }
    },
    "%@ cannot uninstall itself.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kendini kaldıramaz."
          }
        }
      }
    },
    "%@ exited with %d: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ exited with %2$d: %3$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$d koduyla sonlandı: %3$@"
          }
        }
      }
    },
    "%@ installs updates for this app; updating it here could break licensing or conflict.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulamanın güncellemelerini %@ yüklüyor; burada güncellemek lisansı bozabilir veya çakışmaya yol açabilir."
          }
        }
      }
    },
    "%@ is a symbolic link and was skipped.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sembolik bağlantı olduğu için atlandı."
          }
        }
      }
    },
    "%@ is outside the allowed folders.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ izin verilen klasörlerin dışında."
          }
        }
      }
    },
    "%@ is part of macOS and cannot be uninstalled.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ macOS'in bir parçası olduğundan kaldırılamaz."
          }
        }
      }
    },
    "%@ is pinned; unpin it with `brew unpin %@` to upgrade": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is pinned; unpin it with `brew unpin %2$@` to upgrade"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sabitlenmiş; yükseltmek için `brew unpin %2$@` ile sabitlemeyi kaldırın"
          }
        }
      }
    },
    "%@ is running": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ çalışıyor"
          }
        }
      }
    },
    "%@ is running. Quit it before uninstalling.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ çalışıyor. Kaldırmadan önce uygulamadan çıkın."
          }
        }
      }
    },
    "%@ no longer contains the scanned app.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ artık taranan uygulamayı içermiyor."
          }
        }
      }
    },
    "%@ no longer exists.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ artık mevcut değil."
          }
        }
      }
    },
    "%@ was kept because the app could not be moved to the Trash.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama Çöp Sepeti'ne taşınamadığı için %@ korundu."
          }
        }
      }
    },
    "%@ was not part of the scan.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ taramanın parçası değildi."
          }
        }
      }
    },
    "%lld updates available": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld güncelleme mevcut"
          }
        }
      }
    },
    "1 update available": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 güncelleme mevcut"
          }
        }
      }
    },
    "App Store updates are installed by the App Store": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store güncellemelerini App Store yükler"
          }
        }
      }
    },
    "Application": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama"
          }
        }
      }
    },
    "Application Support": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Application Support"
          }
        }
      }
    },
    "Auto-installs in %lld days": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld gün içinde otomatik yüklenecek"
          }
        }
      }
    },
    "Auto-installs within a day": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir gün içinde otomatik yüklenecek"
          }
        }
      }
    },
    "Automatic installs are off for this app": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulama için otomatik yükleme kapalı"
          }
        }
      }
    },
    "Caches": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önbellekler"
          }
        }
      }
    },
    "Check whether the developer offers an Apple Silicon or Universal build.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geliştiricinin Apple Silicon veya Universal sürüm sunup sunmadığını kontrol edin."
          }
        }
      }
    },
    "Choose an app first.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce bir uygulama seçin."
          }
        }
      }
    },
    "Code signature invalid: %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod imzası geçersiz: %@"
          }
        }
      }
    },
    "Common for older or hobby apps. Prefer a notarized release when one exists.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eski veya hobi uygulamalarında yaygındır. Varsa noter onaylı bir sürümü tercih edin."
          }
        }
      }
    },
    "Confirm the developer legitimately changed before trusting this build.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sürüme güvenmeden önce geliştiricinin gerçekten değiştiğini doğrulayın."
          }
        }
      }
    },
    "Connection to privileged helper was interrupted": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayrıcalıklı yardımcıyla bağlantı kesildi"
          }
        }
      }
    },
    "Connection to privileged helper was invalidated": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayrıcalıklı yardımcıyla bağlantı geçersiz kılındı"
          }
        }
      }
    },
    "Consider removing it to free disk space and reduce update work.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk alanı açmak ve güncelleme yükünü azaltmak için kaldırmayı düşünün."
          }
        }
      }
    },
    "Cookies": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çerezler"
          }
        }
      }
    },
    "Could not move %@ to the Trash: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not move %1$@ to the Trash: %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Çöp Sepeti'ne taşınamadı: %2$@"
          }
        }
      }
    },
    "Could not register privileged helper: %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayrıcalıklı yardımcı kaydedilemedi: %@"
          }
        }
      }
    },
    "Could not unregister privileged helper: %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayrıcalıklı yardımcının kaydı silinemedi: %@"
          }
        }
      }
    },
    "Critical": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kritik"
          }
        }
      }
    },
    "Developer ID signed, but Apple has not notarized it.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Developer ID ile imzalanmış ancak Apple tarafından noter onayı verilmemiş."
          }
        }
      }
    },
    "Developer changed": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geliştirici değişti"
          }
        }
      }
    },
    "Do not install it unless you trust the source; check the developer's site for a notarized build.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaynağa güvenmiyorsanız yüklemeyin; noter onaylı bir sürüm için geliştiricinin sitesine bakın."
          }
        }
      }
    },
    "Download host changed": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirme sunucusu değişti"
          }
        }
      }
    },
    "Downloaded file checksum does not match": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirilen dosyanın sağlama toplamı eşleşmiyor"
          }
        }
      }
    },
    "Gatekeeper does not accept this app: %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gatekeeper bu uygulamayı kabul etmiyor: %@"
          }
        }
      }
    },
    "Gatekeeper rejected the downloaded update: %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gatekeeper indirilen güncellemeyi reddetti: %@"
          }
        }
      }
    },
    "Group Container": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grup Kapsayıcısı"
          }
        }
      }
