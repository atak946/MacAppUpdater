    "Info": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilgi"
          }
        }
      }
    },
    "Install failed: %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yükleme başarısız: %@"
          }
        }
      }
