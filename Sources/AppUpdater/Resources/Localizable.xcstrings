      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sırala"
          }
        }
      }
    },
    "No apps match": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşleşen uygulama yok"
          }
        }
      }
    },
    "Try another filter or search term.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir filtre veya arama terimi deneyin."
          }
        }
      }
