    "%@ manages updates for this app. App Updater won't install them.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulamanın güncellemelerini %@ yönetiyor. App Updater bunları yüklemez."
