    " — latest %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": " — en son %@"
          }
        }
      }
    },
    "%@\nClick to open the download page.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nİndirme sayfasını açmak için tıklayın."
          }
        }
      }
    },
    "%@\nClick to retry.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nYeniden denemek için tıklayın."
          }
        }
      }
    },
    "%@\nClick to try again once you're online.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nÇevrimiçi olduğunuzda yeniden denemek için tıklayın."
          }
        }
      }
    },
    "%@ %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@"
