        }
      }
    },
    "Apps can accept incoming connections freely.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamalar gelen bağlantıları serbestçe kabul edebilir."
          }
        }
      }
    },
    "Your Mac ignores probes from the network.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'iniz ağdan gelen yoklamaları yanıtlamıyor."
          }
        }
      }
    },
    "Your Mac answers network probes such as ping.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'iniz ping gibi ağ yoklamalarını yanıtlıyor."
          }
        }
      }
    },
    "Core system files are protected from changes.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temel sistem dosyaları değişikliğe karşı korunuyor."
          }
        }
      }
    },
    "System files can be modified. Re-enable it from Recovery.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem dosyaları değiştirilebilir. Kurtarma'dan yeniden açın."
          }
        }
      }
    },
    "Only trusted, notarized apps open without a warning.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca güvenilir, noter onaylı uygulamalar uyarısız açılır."
          }
        }
      }
    },
    "Apps from any source open without checks.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her kaynaktan uygulama denetimsiz açılıyor."
          }
