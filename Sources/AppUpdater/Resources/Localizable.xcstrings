      }
    },
    "Analyzing your apps…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamalarınız analiz ediliyor…"
          }
        }
      }
    },
    "Another app uses the same bundle ID (%@). Related files may belong to it, so only the app is selected.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir uygulama aynı paket kimliğini kullanıyor (%@). İlgili dosyalar ona ait olabilir, bu nedenle yalnızca uygulama seçildi."
          }
        }
      }
    },
