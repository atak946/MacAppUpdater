          }
        }
      }
    },
    "App Updater": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "App Updater"
          }
        }
      }
    },
    "Application": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama"
          }
        }
      }
    },
    "Applies to apps updated from a disk image or zip. App Store apps and installer packages always ask first.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk görüntüsü veya zip ile güncellenen uygulamalara uygulanır. App Store uygulamaları ve yükleyici paketleri her zaman önce sorar."
          }
        }
      }
    },
    "Apps installed": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüklü uygulamalar"
          }
        }
      }
    },
    "Architecture": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mimari"
          }
        }
      }
    },
    "Asking Homebrew which formulae are outdated.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew'a hangi formüllerin güncel olmadığı soruluyor."
          }
        }
      }
    },
    "At least %@ to download": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En az %@ indirilecek"
          }
        }
      }
    },
    "At risk": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Risk altında"
          }
        }
      }
    },
    "Attention": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikkat"
          }
        }
      }
    },
    "Automatic update failed. Download it manually from the website.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik güncelleme başarısız. Web sitesinden elle indirin."
          }
        }
      }
    },
    "Backups are not affected.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedekler etkilenmez."
          }
        }
      }
    },
    "Blind spots": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kör noktalar"
          }
        }
      }
    },
    "Blocked: %@ isn't signed with a valid Developer ID, so the publisher of this update can't be verified. Update it manually from the vendor's website.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Engellendi: %@ geçerli bir Developer ID ile imzalanmamış, bu yüzden bu güncellemenin yayıncısı doğrulanamıyor. Uygulamayı üreticinin web sitesinden elle güncelleyin."
          }
        }
      }
    },
    "Blocked: Apple has not notarized this update, and your organization requires notarization.": {
      "localizations": {
